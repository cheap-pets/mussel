{
  "permissions": {
    "allow": [
      "Bash(gh search:*)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(npm run:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk read *)",
      "mcp__fff__grep",
      "mcp__fff__find_files",
      "mcp__fff__multi_grep",
